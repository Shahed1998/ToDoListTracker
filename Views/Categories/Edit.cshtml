@model Category
@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Reading, Gaming, Social Media" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<CategoryType>()" class="form-control"></select>
        <small class="hint-text">Negative categories are for self-penalty logging (they subtract from your daily score).</small>
    </div>

    <div class="form-group">
        <label asp-for="ColorHex">Color</label>
        <div class="color-picker-row">
            <input type="color" id="colorSwatch" class="color-swatch-input" value="@Model.ColorHex" aria-label="Pick a color" />
            <input asp-for="ColorHex" class="form-control color-hex-input" maxlength="7" placeholder="#4f46e5" />
        </div>
        <span asp-validation-for="ColorHex" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-primary">Save Category</button>
    <a asp-action="Index" class="btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        (function () {
            var swatch = document.getElementById('colorSwatch');
            var hexInput = document.getElementById('ColorHex');
            swatch.addEventListener('input', function () { hexInput.value = swatch.value; });
            hexInput.addEventListener('input', function () {
                if (/^#[0-9a-fA-F]{6}$/.test(hexInput.value)) { swatch.value = hexInput.value; }
            });
        })();
    </script>
}
